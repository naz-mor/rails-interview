<main class="page-shell">
  <section class="todo-panel">
    <% persisted_items = @todo_list.todo_items.select(&:persisted?) %>

    <header class="todo-panel__header todo-panel__header--with-action">
      <h1><%= @todo_list.name %></h1>
      <%= render "complete_all", todo_list: @todo_list %>
    </header>

    <div class="todo-panel__body">
      <% if @todo_list.errors.any? %>
        <div class="error-box">
          <% @todo_list.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= render "todo_items/inline_form", todo_list: @todo_list, todo_item: @todo_list.todo_items.build %>

      <div class="items-list" id="todo_items">
        <% if persisted_items.empty? %>
          <p class="empty-state" id="empty_todo_items">No tasks have been entered yet</p>
        <% else %>
          <%= render partial: "todo_items/todo_item", collection: persisted_items, locals: { todo_list: @todo_list } %>
        <% end %>
      </div>
    </div>
  </section>
</main>
