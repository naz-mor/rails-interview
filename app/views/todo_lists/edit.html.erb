<main class="page-shell">
  <section class="todo-panel">
    <header class="todo-panel__header">
      <h1><%= @todo_list.name %></h1>
    </header>

    <div class="todo-panel__body">
      <% if @todo_list.errors.any? || @todo_item&.errors&.any? %>
        <div class="error-box">
          <% @todo_list.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
          <% @todo_item&.errors&.full_messages&.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: [@todo_list, @todo_item || @todo_list.todo_items.build], url: todo_list_todo_items_path(@todo_list), class: "inline-create-form" do |f| %>
        <%= f.text_field :name, placeholder: "Add your task…", class: "text-input" %>
        <%= image_submit_tag "add-button.png", alt: "Add task", class: "input-action" %>
      <% end %>

      <div class="items-list">
        <% persisted_items = @todo_list.todo_items.select(&:persisted?) %>
        <% if persisted_items.empty? %>
          <p class="empty-state">No tasks have been entered yet</p>
        <% else %>
          <% persisted_items.each do |todo_item| %>
            <article class="todo-row">
              <%= button_to todo_list_todo_item_path(@todo_list, todo_item), method: :patch, params: { todo_item: { completed: (!todo_item.completed?).to_s } }, class: "completion-button completion-button--#{todo_item.completed? ? 'checked' : 'unchecked'}" do %>
                <% if todo_item.completed? %>
                  <%= image_tag "checked.png", alt: "Mark #{todo_item.name} incomplete" %>
                <% else %>
                  <span class="unchecked-circle" aria-label="Mark <%= todo_item.name %> complete"></span>
                <% end %>
              <% end %>

              <span class="todo-row__text <%= 'todo-row__text--completed' if todo_item.completed? %>"><%= todo_item.name %></span>

              <%= button_to todo_list_todo_item_path(@todo_list, todo_item), method: :delete, class: "icon-button", form: { data: { turbo_confirm: "Are you sure you want to delete \"#{todo_item.name}\"?" } } do %>
                <%= image_tag "delete.png", alt: "Delete #{todo_item.name}" %>
              <% end %>
            </article>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
</main>
