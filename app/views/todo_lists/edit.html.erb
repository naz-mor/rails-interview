<main class="page-shell">
  <section class="todo-panel">
    <header class="todo-panel__header todo-panel__header--with-action">
      <%= render "todo_lists/name/show", todo_list: @todo_list %>
      <%= render "complete_all", todo_list: @todo_list %>
    </header>

    <div class="todo-panel__body">
      <% if @todo_list.errors.any? %>
        <div class="error-box">
          <% @todo_list.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= render "todo_items/inline_form", todo_list: @todo_list, todo_item: @todo_list.todo_items.build %>

      <%= render "todo_items/list", todo_list: @todo_list, todo_items: @todo_items %>
    </div>
  </section>
</main>
