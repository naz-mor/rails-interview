<%= form_with model: @todo_list, url: todo_list_path(@todo_list), method: :patch do |f| %>
  <% if @todo_list.errors.any? %>
    <div>
      <% @todo_list.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <%= f.submit 'Update Todo List' %>
<% end %>
