<%= turbo_frame_tag "new_todo_list" do %>
  <% if todo_list.errors.any? %>
    <div class="error-box">
      <% todo_list.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: todo_list, url: todo_lists_path, class: "inline-create-form" do |f| %>
    <%= f.text_field :name, placeholder: "Add your list…", class: "text-input" %>
    <%= image_submit_tag "add-button.png", alt: "Add todo list", class: "input-action" %>
  <% end %>
<% end %>
