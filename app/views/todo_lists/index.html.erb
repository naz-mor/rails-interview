<main class="page-shell">
  <section class="todo-panel">
    <header class="todo-panel__header">
      <h1>Todo Lists</h1>
    </header>

    <div class="todo-panel__body">
      <%= render "inline_form", todo_list: TodoList.new %>

      <div class="items-list items-list--scrollable" id="todo_lists">
        <% if @todo_lists.empty? %>
          <p class="empty-state" id="empty_todo_lists">No lists have been entered yet</p>
        <% else %>
          <%= render @todo_lists %>

          <% if @next_page %>
            <%= render "shared/pagination_frame", frame_id: "todo_lists_page_#{@next_page}", src: todo_lists_path(page: @next_page, per_page: @per_page) %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
</main>
