<main class="page-shell">
  <section class="todo-panel">
    <header class="todo-panel__header">
      <h1>Todo Lists</h1>
    </header>

    <div class="todo-panel__body">
      <% if @todo_list.errors.any? %>
        <div class="error-box">
          <% @todo_list.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: @todo_list, url: todo_lists_path, class: "inline-create-form" do |f| %>
        <%= f.text_field :name, placeholder: "Add your list…", class: "text-input" %>
        <%= image_submit_tag "add-button.png", alt: "Add todo list", class: "input-action" %>
      <% end %>

      <div class="items-list">
        <% if @todo_lists.empty? %>
          <p class="empty-state">No lists have been entered yet</p>
        <% else %>
          <% @todo_lists.each do |todo_list| %>
            <article class="todo-row">
              <%= link_to todo_list.name, edit_todo_list_path(todo_list), class: "todo-row__text todo-row__link" %>
              <%= button_to todo_list_path(todo_list), method: :delete, class: "icon-button", form: { data: { turbo_confirm: "Are you sure you want to delete \"#{todo_list.name}\"?" } } do %>
                <%= image_tag "delete.png", alt: "Delete #{todo_list.name}" %>
              <% end %>
            </article>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
</main>
