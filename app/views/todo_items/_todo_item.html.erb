<article class="todo-row" id="<%= dom_id(todo_item) %>">
  <%= button_to todo_list_todo_item_path(todo_list, todo_item), method: :patch, params: { todo_item: { completed: (!todo_item.completed?).to_s } }, class: "completion-button completion-button--#{todo_item.completed? ? 'checked' : 'unchecked'}", data: { turbo_submits_with: "Saving…" } do %>
    <% if todo_item.completed? %>
      <%= image_tag "checked.png", alt: "Mark #{todo_item.name} incomplete" %>
    <% else %>
      <span class="unchecked-circle" aria-label="Mark <%= todo_item.name %> complete"></span>
    <% end %>
  <% end %>

  <span class="todo-row__text <%= 'todo-row__text--completed' if todo_item.completed? %>"><%= todo_item.name %></span>

  <%= button_to todo_list_todo_item_path(todo_list, todo_item), method: :delete, class: "icon-button", data: { turbo_submits_with: "Deleting…" }, form: { data: { turbo_confirm: "Are you sure you want to delete \"#{todo_item.name}\"?" } } do %>
    <%= image_tag "delete.png", alt: "Delete #{todo_item.name}" %>
  <% end %>
</article>
