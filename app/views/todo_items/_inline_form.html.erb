<%= turbo_frame_tag "new_todo_item" do %>
  <% if todo_item.errors.any? %>
    <aside class="error-overlay" role="alert" aria-live="assertive" data-controller="dismissible">
      <div class="error-box">
        <button class="error-box__close" type="button" aria-label="Close errors" data-action="dismissible#dismiss">&times;</button>
        <% todo_item.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    </aside>
  <% end %>

  <%= form_with model: [todo_list, todo_item], url: todo_list_todo_items_path(todo_list), class: "inline-create-form" do |f| %>
    <%= f.text_field :name, placeholder: "Add your task…", class: "text-input" %>
    <%= image_submit_tag "add-button.png", alt: "Add task", class: "input-action", data: { turbo_submits_with: "Adding…" } %>
  <% end %>
<% end %>
