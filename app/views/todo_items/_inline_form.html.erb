<%= turbo_frame_tag "new_todo_item" do %>
  <%= render "shared/errors", object: todo_item %>

  <%= form_with model: [todo_list, todo_item], url: todo_list_todo_items_path(todo_list), class: "inline-create-form" do |f| %>
    <%= f.text_field :name, placeholder: "Add your task…", class: "text-input" %>
    <%= image_submit_tag "add-button.png", alt: "Add task", class: "input-action", data: { turbo_submits_with: "Adding…" } %>
  <% end %>
<% end %>
